# Puerto donde escucha el servidor (el biométrico apunta aquí: Menú > Comunicación > Servidor en la nube / ADMS)
PORT=8090
# Ruta de la base de datos SQLite
DB_PATH=./data/asistencia.db
# Zona horaria que se le informa al equipo (Colombia = -5)
DEVICE_TZ=-5
# Marcaciones del mismo empleado dentro de esta ventana (minutos) se consideran duplicadas en reportes
DEDUP_MINUTES=2
# Minutos sin contacto para marcar un equipo como desconectado
OFFLINE_AFTER_MIN=3
# Token para la API/panel (déjalo vacío solo en LAN de confianza)
API_TOKEN=
